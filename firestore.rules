rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models
    // ===============================================================
    //
    // Collection: posts/{postId}
    // Document ID: Alphanumeric post ID (e.g., 'post-1', 'post-builder-1')
    // Fields:
    //   - postedByPhone: string (required, max 64) - Author phone or Auth UID [Immutable on update]
    //   - postedBy: string (optional, max 100) - Author display name / username
    //   - postedByAvatarSeed: number (optional) - Avatar seed index
    //   - note: string (optional, max 2000) - Bet slip commentary / notes
    //   - url: string (optional, max 1000) - Bet slip link or booking code
    //   - bookmaker: string (optional, max 100) - Bookmaker name
    //   - isCode: bool (optional) - True if booking code, false if link
    //   - tags: list of strings (optional, max 20 items, max 50 chars each)
    //   - likes: int (optional, >= 0) - Atomic like counter
    //   - saves: int (optional, >= 0) - Atomic save/bookmark counter
    //   - shares: int (optional, >= 0) - Atomic share counter
    //   - builtSlip: map (optional) - Built bet slip accumulator payload
    //   - parsed: map (optional) - Parsed slip data
    //   - parseError: string (optional, max 500) - Error string if parse failed
    //   - createdAt: string or timestamp (optional) [Immutable on update]
    //   - updatedAt: string or timestamp (optional)
    //
    // Subcollection: posts/{postId}/likes/{userId}
    // Document ID: Authenticated user's Phone number or UID
    // Fields:
    //   - userId: string (required, max 64) - Must match auth user and document ID
    //   - username: string (optional, max 100) - Display name
    //   - postId: string (optional, max 128) - Parent post ID
    //   - createdAt: string or timestamp (optional) - Timestamp when like was recorded
    //
    // Subcollection: posts/{postId}/comments/{commentId}
    // Document ID: Unique comment ID
    // Fields:
    //   - user / username: string (optional, max 100)
    //   - userId / postedByPhone: string (optional, max 64)
    //   - text / comment: string (optional, max 2000)
    //   - likes: int (optional, >= 0) - Atomic comment like counter
    //   - createdAt: string or timestamp (optional)
    //   - updatedAt: string or timestamp (optional)
    //
    // Subcollection: posts/{postId}/comments/{commentId}/likes/{userId}
    // Document ID: Authenticated user's Phone number or UID
    // Fields:
    //   - userId: string (required, max 64) - Must match auth user and document ID
    //   - username: string (optional, max 100) - Display name
    //   - commentId: string (optional, max 128)
    //   - createdAt: string or timestamp (optional)
    //
    // Subcollection: users/{userId}/savedPosts/{postId}
    // Document ID: Post ID of the saved bet slip
    // Fields:
    //   - postId: string (optional, max 128) - Reference to saved post
    //   - contentType: string (optional, max 32) - e.g., 'reel'
    //   - savedAt: string or timestamp (optional) - Bookmark timestamp
    //   - createdAt: string or timestamp (optional)
    //
    // Subcollection: users/{userId}/likedPosts/{postId}
    // Document ID: Post ID of the liked bet slip
    // Fields:
    //   - postId: string (optional, max 128) - Reference to liked post
    //   - likedAt: string or timestamp (optional) - Like timestamp
    //   - createdAt: string or timestamp (optional)
    //
    // Subcollection: users/{userId}/likedComments/{commentId}
    // Document ID: Comment ID of the liked comment
    // Fields:
    //   - commentId: string (optional, max 128) - Reference to liked comment
    //   - likedAt: string or timestamp (optional) - Like timestamp
    //   - createdAt: string or timestamp (optional)
    //
    // Collection: comments/{commentId}
    // Document ID: Unique comment ID
    // Fields:
    //   - likes: int (optional, >= 0) - Atomic comment like counter
    //   - updatedAt: string or timestamp (optional)
    //
    // Subcollection: comments/{commentId}/likes/{userId}
    // Document ID: Authenticated user's Phone number or UID
    // Fields:
    //   - userId: string (required, max 64)
    //   - commentId: string (optional, max 128)
    //   - username: string (optional, max 100)
    //   - createdAt: string or timestamp (optional)
    //
    // Subcollection: picks/{pickId}/likes/{userId}
    // Document ID: Authenticated user's Phone number or UID
    // Fields:
    //   - userId: string (required, max 64)
    //   - username: string (optional, max 100)
    //   - createdAt: string or timestamp (optional)
    //
    // Collection: siteContent/{docId}
    // Document ID: Document ID (e.g., 'homepageFeed', 'post_123', 'media_456')
    // Fields:
    //   - For homepageFeed aggregate:
    //     - carouselItems: list (editorial carousel cards)
    //     - videoItems: list (editorial video reels)
    //     - authorId: string (optional)
    //   - For individual post/media documents:
    //     - id: string
    //     - authorId: string
    //     - authorRole: string
    //
    // Collection: tokenWallets/{userId} (Server-Authoritative Mshindi Token Economy)
    // Document ID: User UID or normalized phone ID
    // Fields:
    //   - userUid: string - Owner UID
    //   - tokenBalance: int (>= 0) - Authoritative active token count
    //   - activeTokenIds: list of strings - Active token unit IDs
    //   - lifetimeEarned: int (>= 0)
    //   - lifetimeSpent: int (>= 0)
    //   - qualifyingReferrals: int (>= 0)
    //   - referralTokensAwardedCount: int (>= 0)
    //   - updatedAt: string or timestamp
    //
    // Collection: tokenUnits/{tokenId} (Server-Authoritative Token Units)
    // Document ID: Unique token unit ID (UUID / deterministic server ID)
    // Fields:
    //   - tokenId: string
    //   - ownerUid: string - Current owner UID
    //   - status: string ('active' | 'consumed' | 'revoked')
    //   - source: string ('signup_bonus' | 'referral_milestone' | 'admin_grant' | 'migration')
    //   - createdAt: string or timestamp
    //   - consumedAt: string or timestamp (optional)
    //
    // Collection: tokenTransactions/{transactionId} (Immutable Append-Only Server Ledger)
    // Document ID: Unique transaction ID
    // Fields:
    //   - transactionId: string
    //   - userUid: string - Associated user UID
    //   - type: string ('credit' | 'debit')
    //   - amount: int
    //   - reason: string
    //   - tokenIds: list of strings
    //   - createdAt: string or timestamp
    //
    // Collection: tokenReferrals/{referralId} (Server-Authoritative Referral Tracking)
    // Document ID: Deterministic referral ID
    // Fields:
    //   - referrerUid: string
    //   - referredUid: string
    //   - qualified: bool
    //   - createdAt: string or timestamp
    //
    // Collection: tokenMigrations/{migrationId} (Server-Authoritative Legacy Token Migration Audit)
    // Document ID: User UID or migration record ID
    // Fields:
    //   - userUid: string
    //   - migratedAt: string or timestamp
    //
    // Collection: subscriptions/{userId} (Server-Authoritative MshindiRoom Premium Subscriptions)
    // Document ID: User UID or phone number
    // Fields:
    //   - userId: string - User UID or phone identifier
    //   - phone: string (optional) - Registered phone number
    //   - username: string (optional) - Display username
    //   - status: string ('active' | 'trial' | 'expired' | 'none')
    //   - plan: string ('weekly' | 'monthly' | 'trial' | null)
    //   - trialClaimed: bool - Whether 3-day trial was claimed
    //   - trialStartedAt: string or timestamp (optional)
    //   - trialExpiresAt: string or timestamp (optional)
    //   - activatedAt: string or timestamp (optional)
    //   - expiresAt: string or timestamp (optional)
    //   - nextPaymentDate: string or timestamp (optional)
    //   - lastPaymentRef: string (optional) - M-Pesa transaction ref or trial tag
    //   - amountKsh: number (optional) - Paid amount in KES
    //   - updatedAt: string or timestamp
    //
    // Subcollection: users/{userId}/subscriptionHistory/{historyId} &
    // Collection: subscriptionHistory/{historyId} (Immutable Subscription Event History)
    // Document ID: Unique history record ID (e.g. 'sub_QK12345678', 'trial_<uid>_<ts>')
    // Fields:
    //   - id: string - History record ID
    //   - userId: string - Associated user UID / phone
    //   - phone: string (optional)
    //   - username: string (optional)
    //   - plan: string ('weekly' | 'monthly' | 'trial')
    //   - type: string ('subscription' | 'trial')
    //   - amountKsh: number - Payment amount (0 for trial)
    //   - transactionRef: string - M-Pesa transaction code or trial ref
    //   - startDate: string or timestamp
    //   - endDate: string or timestamp
    //   - status: string ('active' | 'expired' | 'completed')
    //   - createdAt: string or timestamp
    //
    // ===============================================================

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super-Administrator: 0743304579 (normalized formats: +254743304579, 254743304579, 0743304579)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.phone_number == '+254743304579' ||
        request.auth.token.phone_number == '254743304579' ||
        request.auth.token.phone_number == '0743304579' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.phone_number == userId ||
        request.auth.token.phone_number == ('+254' + userId) ||
        request.auth.token.phone_number == ('254' + userId)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Protected token/currency fields on users/{userId} (strictly server-controlled)
    function hasNoProtectedTokenFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'mshindiTokens',
        'tokenBalance',
        'activeTokenIds',
        'tokenTransactions',
        'qualifyingReferrals',
        'referralTokensAwardedCount'
      ]);
    }

    function hasNoProtectedTokenFieldsOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'mshindiTokens',
        'tokenBalance',
        'activeTokenIds',
        'tokenTransactions',
        'qualifyingReferrals',
        'referralTokensAwardedCount'
      ]);
    }

    function hasNoProtectedTokenFields() {
      return resource == null
        ? hasNoProtectedTokenFieldsOnCreate()
        : hasNoProtectedTokenFieldsOnUpdate();
    }

    // Post Author verification
    function isPostAuthor(phoneOrUid) {
      return isSignedIn() && (
        phoneOrUid == request.auth.token.phone_number ||
        phoneOrUid == request.auth.uid ||
        isOwner(phoneOrUid)
      );
    }

    // Comment Author verification
    function isCommentAuthor(docData) {
      return isSignedIn() && (
        (('userId' in docData) && (isOwner(docData.userId) || docData.userId == request.auth.uid || docData.userId == request.auth.token.phone_number)) ||
        (('postedByPhone' in docData) && (isOwner(docData.postedByPhone) || docData.postedByPhone == request.auth.token.phone_number)) ||
        (('authorPhone' in docData) && (isOwner(docData.authorPhone) || docData.authorPhone == request.auth.token.phone_number)) ||
        (('user' in docData) && isOwner(docData.user)) ||
        (('username' in docData) && isOwner(docData.username))
      );
    }

    // Post creation domain validator
    function isValidPostCreate(data) {
      return ('postedByPhone' in data) &&
        data.postedByPhone is string &&
        data.postedByPhone.size() > 0 &&
        data.postedByPhone.size() <= 64 &&
        (!('postedBy' in data) || (data.postedBy is string && data.postedBy.size() <= 100)) &&
        (!('postedByAvatarSeed' in data) || data.postedByAvatarSeed is number) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 2000)) &&
        (!('url' in data) || (data.url is string && data.url.size() <= 1000)) &&
        (!('bookmaker' in data) || (data.bookmaker is string && data.bookmaker.size() <= 100)) &&
        (!('isCode' in data) || data.isCode is bool) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('likes' in data) || (data.likes is int && data.likes >= 0)) &&
        (!('saves' in data) || (data.saves is int && data.saves >= 0)) &&
        (!('shares' in data) || (data.shares is int && data.shares >= 0)) &&
        (!('builtSlip' in data) || data.builtSlip is map) &&
        (!('parsed' in data) || data.parsed is map) &&
        (!('parseError' in data) || (data.parseError is string && data.parseError.size() <= 500));
    }

    // Post author update domain validator: prevents author reassignment and verifies schema
    function isValidPostAuthorUpdate() {
      return request.resource.data.postedByPhone == resource.data.postedByPhone &&
        (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        isValidPostCreate(request.resource.data);
    }

    // Post diff affected keys helper
    function postAffectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Post atomic counter update domain validator for community interactions (like / save / share):
    // Allows ONLY 'likes', 'saves', 'shares', and 'updatedAt' to change.
    // Odds, legs, author, commentary, and slip metadata are locked and immutable.
    function isValidPostCounterUpdate() {
      return postAffectedKeys().hasOnly(['likes', 'saves', 'shares', 'updatedAt']) &&
        // Atomic 'likes' counter step (+1 or -1, >= 0)
        (!postAffectedKeys().hasAny(['likes']) || (
          request.resource.data.likes is int &&
          request.resource.data.likes >= 0 &&
          (
            (!('likes' in resource.data) && request.resource.data.likes <= 1) ||
            ('likes' in resource.data && (
              request.resource.data.likes == resource.data.likes + 1 ||
              request.resource.data.likes == resource.data.likes - 1
            ))
          )
        )) &&
        // Atomic 'saves' counter step (+1 or -1, >= 0)
        (!postAffectedKeys().hasAny(['saves']) || (
          request.resource.data.saves is int &&
          request.resource.data.saves >= 0 &&
          (
            (!('saves' in resource.data) && request.resource.data.saves <= 1) ||
            ('saves' in resource.data && (
              request.resource.data.saves == resource.data.saves + 1 ||
              request.resource.data.saves == resource.data.saves - 1
            ))
          )
        )) &&
        // Atomic 'shares' counter step (+1, >= 0)
        (!postAffectedKeys().hasAny(['shares']) || (
          request.resource.data.shares is int &&
          request.resource.data.shares >= 0 &&
          (
            (!('shares' in resource.data) && request.resource.data.shares == 1) ||
            ('shares' in resource.data && request.resource.data.shares == resource.data.shares + 1)
          )
        )) &&
        // 'updatedAt' format validation
        (!postAffectedKeys().hasAny(['updatedAt']) || (
          request.resource.data.updatedAt is string ||
          request.resource.data.updatedAt is timestamp
        ));
    }

    // Comment atomic counter update domain validator:
    // Allows ONLY 'likes' and 'updatedAt' to be updated atomically.
    function isValidCommentCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'updatedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) || (
          request.resource.data.likes is int &&
          request.resource.data.likes >= 0 &&
          (
            (!('likes' in resource.data) && request.resource.data.likes <= 1) ||
            ('likes' in resource.data && (
              request.resource.data.likes == resource.data.likes + 1 ||
              request.resource.data.likes == resource.data.likes - 1
            ))
          )
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || (
          request.resource.data.updatedAt is string ||
          request.resource.data.updatedAt is timestamp
        ));
    }

    // Like document schema validator
    function isValidLikeDoc(data, userId) {
      return ('userId' in data) &&
        data.userId == userId &&
        data.userId is string &&
        data.userId.size() <= 64 &&
        (!('postId' in data) || (data.postId is string && data.postId.size() <= 128)) &&
        (!('commentId' in data) || (data.commentId is string && data.commentId.size() <= 128)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    // Saved post document schema validator
    function isValidSavedPostDoc(data) {
      return (!('postId' in data) || (data.postId is string && data.postId.size() <= 128)) &&
        (!('contentType' in data) || (data.contentType is string && data.contentType.size() <= 32)) &&
        (!('savedAt' in data) || data.savedAt is string || data.savedAt is timestamp) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    // Liked post lookup document validator
    function isValidLikedPostDoc(data, postId) {
      return (!('postId' in data) || (data.postId is string && data.postId == postId && data.postId.size() <= 128)) &&
        (!('likedAt' in data) || data.likedAt is string || data.likedAt is timestamp) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    // Liked comment lookup document validator
    function isValidLikedCommentDoc(data, commentId) {
      return (!('commentId' in data) || (data.commentId is string && data.commentId == commentId && data.commentId.size() <= 128)) &&
        (!('likedAt' in data) || data.likedAt is string || data.likedAt is timestamp) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. SITE CONTENT & EDITORIAL FEED (homepage carousel, highlights, editorial news)
    // Public read so all visitors see latest news; create, update, and delete strictly restricted to isAdmin()
    match /siteContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /feed/{feedId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. JACKPOT ROOMS & CONSENSUS ARENAS (rooms management, live sync, settlement)
    // Public read for punters; creating/publishing and deleting rooms restricted strictly to admin 0743304579
    match /jackpots/{jackpotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. SPORTS FIXTURES & BATCHES (PDF parsed fixtures, match slates, odds slates)
    // Public read for match schedules; ingestion, modification, and clearing restricted strictly to admin 0743304579
    match /fixtures/{fixtureId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /fixturesBatches/{batchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 4. MODERATING DICTIONARY (banned keywords, profanity, scam heuristics)
    // Public read for client chat moderation; uploading dictionary entries, editing, or deleting restricted strictly to admin 0743304579
    match /moderationDictionary/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // USERS COLLECTION: user owns their profile, admin has full administrative oversight
    // Non-admin client writes cannot set or mutate authoritative Mshindi token/currency fields
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(userId) && hasNoProtectedTokenFields());
      allow update: if isAdmin() || (isOwner(userId) && hasNoProtectedTokenFields());
      allow delete: if isAdmin();

      // Saved posts private bookmarks subcollection
      match /savedPosts/{postId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidSavedPostDoc(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Liked posts lookup subcollection
      match /likedPosts/{postId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidLikedPostDoc(request.resource.data, postId);
        allow update: if false;
      }

      // Liked comments lookup subcollection
      match /likedComments/{commentId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidLikedCommentDoc(request.resource.data, commentId);
        allow update: if false;
      }

      // Subscription history subcollection (server-authoritative)
      match /subscriptionHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // 4B. MSHINDI TOKEN ECONOMY (Strictly Server-Controlled via Firebase Admin SDK)
    // Users may read their own authorized token records, but client writes are unconditionally denied.
    match /tokenWallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /tokenUnits/{tokenId} {
      allow read: if isSignedIn() && (isOwner(resource.data.ownerUid) || isAdmin());
      allow create, update, delete: if false;
    }

    match /tokenTransactions/{transactionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userUid) || isAdmin());
      allow create, update, delete: if false;
    }

    match /tokenReferrals/{referralId} {
      allow read: if isSignedIn() && (isOwner(resource.data.referrerUid) || isOwner(resource.data.referredUid) || isAdmin());
      allow create, update, delete: if false;
    }

    match /tokenMigrations/{migrationId} {
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.userUid));
      allow create, update, delete: if false;
    }

    // 4C. MSHINDIROOM PREMIUM SUBSCRIPTIONS (Strictly Server-Authoritative via Firebase Admin SDK)
    // Users may read their own active subscription record, but all client writes are unconditionally denied.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Top-level subscription history ledger (server-authoritative audit trail)
    match /subscriptionHistory/{historyId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create, update, delete: if false;
    }

    // PLAYER RATINGS: public read, write restricted to profile owner or admin
    match /playerRatings/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // History subcollection
      match /history/{historyId} {
        allow read: if true;
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // PICKS COLLECTION: public read, author or admin can create/update/delete
    match /picks/{pickId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.phone_number ||
        isAdmin()
      );
      allow update, delete: if (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.phone_number
      )) || (isSignedIn() && isValidCommentCounterUpdate()) || isAdmin();

      // Pick likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId && isValidLikeDoc(request.resource.data, userId);
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow update: if false;
      }
    }

    // 5. COMMUNITY POSTS & BET SLIP REELS (public feed, likes, counters, bookmarks, comments)
    match /posts/{postId} {
      // Public read so visitors and punters can view shared community slips
      allow read: if true;

      // Author or admin can create post with validated ownership and schema
      allow create: if isSignedIn() && (
        request.resource.data.postedByPhone == request.auth.token.phone_number ||
        request.resource.data.postedByPhone == request.auth.uid ||
        isOwner(request.resource.data.postedByPhone) ||
        isAdmin()
      ) && isValidPostCreate(request.resource.data);

      // Updates:
      // 1) Author or admin can update post content (author cannot reassign ownership)
      // 2) Any authenticated user can atomically like, unlike, save, or share without modifying post content
      allow update: if (
        ((isAdmin() || (isSignedIn() && ('postedByPhone' in resource.data) && isPostAuthor(resource.data.postedByPhone))) && isValidPostAuthorUpdate()) ||
        (isSignedIn() && isValidPostCounterUpdate())
      );

      // Only author or admin can delete post
      allow delete: if isAdmin() || (
        isSignedIn() &&
        ('postedByPhone' in resource.data) &&
        (
          resource.data.postedByPhone == request.auth.token.phone_number ||
          resource.data.postedByPhone == request.auth.uid ||
          isOwner(resource.data.postedByPhone)
        )
      );

      // Likes subcollection: deterministic document keyed by user ID (phone or UID)
      match /likes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId && isValidLikeDoc(request.resource.data, userId);
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow update: if false;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if (isSignedIn() && isCommentAuthor(resource.data)) ||
                         (isSignedIn() && isValidCommentCounterUpdate()) ||
                         isAdmin();
        allow delete: if (isSignedIn() && isCommentAuthor(resource.data)) || isAdmin();

        // Nested comment likes subcollection
        match /likes/{userId} {
          allow read: if true;
          allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId && isValidLikeDoc(request.resource.data, userId);
          allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
          allow update: if false;
        }
      }
    }

    // TOP-LEVEL COMMENTS COLLECTION (discussion forum, standalone comments)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && isValidCommentCounterUpdate()) ||
                       (isSignedIn() && isCommentAuthor(resource.data)) ||
                       isAdmin();
      allow delete: if (isSignedIn() && isCommentAuthor(resource.data)) || isAdmin();

      // Top-level comment likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId && isValidLikeDoc(request.resource.data, userId);
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow update: if false;
      }
    }
  }
}
