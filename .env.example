# ==========================================
# Mshindi Projo Environment Variables
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Ava Support Specialist, Mshindi Advisor, Jackpot Parser).
# In Google AI Studio Build, this is automatically injected at runtime from secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# SPORTS_FEED_API_KEY: Secret key for sports fixtures & calibrated consensus market feed
SPORTS_FEED_API_KEY="your-sports-feed-api-key"

# APP_URL: The public web application root URL.
# In Cloud Run container deployment, this is automatically injected.
APP_URL="http://localhost:3000"

# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV="development"

# PORT: Default container listening port (Hardcoded to 3000 for Cloud Run / reverse proxy)
PORT=3000

# ==========================================
# Firebase Web App Credentials (.env)
# ==========================================
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyApRSqG1sMFmXYS8yM80s0TsUkWX65qsy8"
VITE_FIREBASE_AUTH_DOMAIN="mshindiroom-production.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="mshindiroom-production"
VITE_FIREBASE_STORAGE_BUCKET="mshindiroom-production.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="31480688378"
VITE_FIREBASE_APP_ID="1:31480688378:web:9f8d0bd5ff526b6acc6343"
