# ==============================================================================
# MshindiRoom Production & Development Environment Variables
# ==============================================================================
# Copy this file to `.env` for local development, or configure these keys in
# Vercel Project Settings -> Environment Variables. NEVER commit `.env`.

# ------------------------------------------------------------------------------
# 1. Core Security & Authentication Secrets (Fail-Closed in Production)
# ------------------------------------------------------------------------------
# Admin authentication PIN verified by `src/lib/adminAuthService.ts`
ADMIN_PIN="replace-with-admin-pin"

# Independent HMAC-SHA256 signing secrets (generate with `openssl rand -hex 32`)
ADMIN_TOKEN_SECRET="replace-with-64-char-hex-secret"
USER_TOKEN_SECRET="replace-with-different-64-char-hex-secret"

# Vercel Cron Bearer authorization secret (`Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET="replace-with-cron-bearer-secret"

# Explicit comma-separated origin allowlist for CORS & SSE (`src/lib/httpSecurity.ts`)
ALLOWED_ORIGINS="https://mshindi.co.ke,https://www.mshindi.co.ke"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK & Cloud Services
# ------------------------------------------------------------------------------
# Raw JSON or base64-encoded Firebase service account key for Production (`VERCEL_ENV=production`)
FIREBASE_SERVICE_ACCOUNT="replace-with-json-or-base64-service-account"

# Isolated service account key for Preview deployments (`VERCEL_ENV=preview`)
FIREBASE_SERVICE_ACCOUNT_PREVIEW="replace-with-preview-json-or-base64-service-account"

# ------------------------------------------------------------------------------
# 3. Distributed Rate Limiting (Upstash Redis REST)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# ------------------------------------------------------------------------------
# 4. AI & Upstream Sports Data APIs
# ------------------------------------------------------------------------------
# Google Gemini API key (server-side only; never expose with VITE_ prefix)
GEMINI_API_KEY="replace-with-gemini-api-key"
# Optional Gemini model override (defaults to `gemini-2.5-flash` when unset)
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 5. Runtime Server Configuration
# ------------------------------------------------------------------------------
API_BASE_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------------------------
# 6. Public Client Firebase Web SDK Configuration (`VITE_*` bundled for browser)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
