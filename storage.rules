rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super-Administrator phone number: 0743304579 (canonical: +254743304579 / 254743304579)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.phone_number == '+254743304579' ||
        request.auth.token.phone_number == '254743304579' ||
        request.auth.token.phone_number == '0743304579' ||
        request.auth.token.admin == true
      );
    }

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 1. Dedicated Homepage Editorial Carousel WebP Media (structured storage)
    // Structure: homepage-carousel/{photoId}/{uniqueFilename}.webp
    // - Public read for homepage visitors and clients
    // - Upload & replacement strictly restricted to verified admin, enforcing WebP MIME and 5MB limit
    // - Deletion strictly restricted to verified admin (distinguished from upload so request.resource is not checked)
    match /homepage-carousel/{photoId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && fileName.matches('^[a-zA-Z0-9_\\-\\.]+\\.webp$');
      allow delete: if isAdmin();
    }

    // 2. Legacy Homepage Editorial Feed Media (carousel photos, hero graphics, news posters)
    // Public read so all visitors and PWA users can view photos; upload and delete strictly restricted to admin 0743304579
    match /feed/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // 3. Fixtures & Match Slates (PDF documents and fixture slates)
    // Public read; upload and delete restricted to admin 0743304579
    match /fixtures/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // 4. Custom Platform Avatars (SVG/PNG vector badges)
    match /avatars/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // 5. Moderating Dictionary Backups & JSON Exports
    match /moderation/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
