{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/generate-build-version.ts && vite build && tsx scripts/generate-build-version.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "generate:glyphs": "node scripts/generate-glyphs.cjs",
    "resync:snapshots": "tsx scripts/resync-corrupted-snapshots.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^5.1.4",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.17.1",
    "@grpc/grpc-js": "^1.14.7"
  }
}
