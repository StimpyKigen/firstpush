{
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/sports/weekly-sync",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/homepage-feed?action=cleanup",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/sports/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/tokens(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/subscription(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/mpesa/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/homepage-feed(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sports/:endpoint*",
      "destination": "/api/sports?endpoint=:endpoint*"
    },
    {
      "source": "/api/cron/:endpoint*",
      "destination": "/api/sports?endpoint=cron-:endpoint*"
    },
    {
      "source": "/api/mpesa/verify-code",
      "destination": "/api/tokens?endpoint=mpesa-verify-code"
    },
    {
      "source": "/api/tokens/:endpoint*",
      "destination": "/api/tokens?endpoint=:endpoint*"
    },
    {
      "source": "/api/subscription/:endpoint*",
      "destination": "/api/subscription?endpoint=:endpoint*"
    },
    {
      "source": "/api/admin/:endpoint*",
      "destination": "/api/admin?endpoint=:endpoint*"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|version\\.json|manifest\\.json|icons/|banners/).*)",
      "destination": "/index.html"
    }
  ]
}
