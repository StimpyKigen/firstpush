{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/weekly-sync.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-sync",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/cron/weekly-sync",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
